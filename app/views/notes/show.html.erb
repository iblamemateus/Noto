<% content_for :title, "Detalhes da nota" %>

<p style="color: green; text-align: center;"><%= notice %></p>

<div class="note-show-container">
  <div class="note-show-card">
    <h1 class="title-note"><%= @note.title %></h1>
    <p class="note-content"><%= @note.content %></p>

    <div class="note-show-actions">
      <div style="display: flex; justify-content: center; align-items: center; gap: 16px;">
        <%= link_to "Editar", edit_note_path(@note), class: "link-btn" %>
        <%= link_to "Voltar", notes_path, class: "form-back-link" %>
      </div>
      
      <div style="margin-top: 20px;">
        <%= button_to "Excluir nota", @note, method: :delete, data: { turbo_confirm: "você possuí toda a certeza disso?" }, class: "destructive-btn" %>
      </div>
    </div>
  </div>
</div>